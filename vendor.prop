# Audio
persist.audio.fluence.voicecomm=true
ro.hardware.audio.primary=sdm660

# Bluetooth
bluetooth.device.default_name=Nokia 6.1

# Camera
persist.camera.ffcolor=true
persist.capture.burst.exposures=0,-9,9

# Fingerprint
ro.hardware.fingerprint=elan

# Radio
ro.rf.power.reduction.for.mcc=1

# Bringup Debugging & Always-On ADB
debug.fdsan=warn
ro.adb.secure=0
persist.sys.usb.config=adb
sys.usb.config=adb
